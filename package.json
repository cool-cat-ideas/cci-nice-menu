  "version": "1.0.0",
  "engines": {
    "node": ">=23.7.0",
    "npm": ">=11.7.0"
  },
  "scripts": {
    "build:admin:css": "node ./node_modules/tailwindcss/lib/cli.js -c tailwind.config.cjs -i ./src/admin-v2/styles/admin.css -o ./views/css/cci_nice_menu_admin.css --minify",
    "build:admin:js": "esbuild ./src/admin-v2/index.jsx --bundle --format=esm --target=es2018 --preserve-symlinks --outfile=./views/js/ccinice-menu-admin.js --minify --alias:react=./node_modules/react --alias:react-dom=./node_modules/react-dom",
    "build:admin": "npm run build:admin:css && npm run build:admin:js",
    "package:presta": "node ../../scripts/build-presta-module-release.mjs products/cci_nice_menu"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@cci/admin-ui": "https://github.com/cool-cat-ideas/cci-admin-ui/releases/download/v1.0.1/cci-admin-ui-1.0.1.tgz",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "swiper": "^12.2.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3"
  },
